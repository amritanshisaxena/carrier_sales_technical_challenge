# Copy this file to ".env" and fill in your real values.

# The API key that the HappyRobot agent must send in the X-API-Key header.
# Pick any long random string. The agent and the dashboard use this.
API_KEY=replace-with-a-long-random-string

# Your FMCSA QCMobile webKey (register at https://mobile.fmcsa.dot.gov/QCDevsite/).
# Leave blank to always use the mock verifier.
FMCSA_WEBKEY=""

# If true, fall back to a fake verifier when no FMCSA key is set or FMCSA errors out.
# Keep true for local dev and demos so a slow/failed FMCSA call never breaks a call.
USE_MOCK_FMCSA=true

# Negotiation tuning.
# Broker's ceiling = loadboard_rate * (1 + BROKER_MAX_UPLIFT). 0.15 = willing to pay up to 15% over listed.
BROKER_MAX_UPLIFT=0.15
# Max number of carrier counter-offers we will entertain before walking away.
MAX_NEGOTIATION_ROUNDS=3

# Where the SQLite file lives.
DATABASE_PATH=data.db
