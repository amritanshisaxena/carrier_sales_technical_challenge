# Copy this file to ".env" and fill in your real values.

# The API key that the HappyRobot agent must send in the X-API-Key header.
API_KEY=replace-with-a-long-random-string

# Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres

# HappyRobot platform API
HAPPYROBOT_API_KEY=your-happyrobot-api-key
HAPPYROBOT_USE_CASE_ID=your-use-case-id
